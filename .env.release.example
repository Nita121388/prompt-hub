# 复制本文件为 .env.release，然后按需填写（不要提交 .env.release）
#
# VSCode Marketplace 发布令牌（必填于 publish）
# 获取方式：VSCode Marketplace → Personal access tokens
VSCE_PAT=
#
# 期望的 Git 远程地址（可选；用于防止把 tag 推到错误仓库）
# 例如：https://github.com/Nita121388/otter.git
EXPECTED_GIT_REMOTE_URL=
#
# 目标远程名（可选；默认 origin）
GIT_REMOTE=origin
